server {
    listen 80;
    listen [::]:80;
    server_name {{ gitea_host_domain }};

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ gitea_host_domain }};

    access_log {{ gitea_host_nginx_access_log }};
    error_log {{ gitea_host_nginx_error_log }};

    client_max_body_size {{ gitea_host_nginx_client_max_body_size }};

    ssl_certificate {{ gitea_host_tls_cert_dir }}/fullchain.pem;
    ssl_certificate_key {{ gitea_host_tls_cert_dir }}/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:{{ gitea_host_http_port }};
        proxy_http_version 1.1;

        proxy_set_header Connection $http_connection;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}