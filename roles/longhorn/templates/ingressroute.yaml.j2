apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: longhorn-ui
  namespace: {{ longhorn_namespace }}
spec:
  entryPoints:
    - websecure
  routes:
    - match: Host(`{{ longhorn_ui_hostname }}`)
      kind: Rule
{% if longhorn_ui_middlewares | length > 0 %}
      middlewares:
{% for middleware in longhorn_ui_middlewares %}
        - name: {{ middleware }}
{% endfor %}
{% endif %}
      services:
        - name: longhorn-frontend
          port: 80
{% if longhorn_tls_enabled %}
  tls:
    certResolver: {{ longhorn_tls_cert_resolver }}
{% endif %}