FROM docker.io/ruby:3.1-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    BUNDLE_PATH=/usr/local/bundle \
    BUNDLE_WITHOUT="development:test"

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    ca-certificates \
    tzdata \
    nodejs \
    npm \
    && rm -rf /var/lib/apt/lists/*

RUN gem install bundler jekyll

RUN useradd -m -u 1000 -s /bin/bash jekyll

WORKDIR /srv/jekyll

COPY Gemfile ./
COPY Gemfile.lock* ./
RUN bundle install

COPY . .

RUN chown -R 1000:1000 /srv/jekyll /usr/local/bundle

USER 1000:1000

EXPOSE 4000

CMD ["jekyll", "serve", "--trace", "--host", "0.0.0.0", "--port", "4000", "--source", "/srv/jekyll", "--destination", "/tmp/jekyll-site", "--disable-disk-cache", "--force_polling"]