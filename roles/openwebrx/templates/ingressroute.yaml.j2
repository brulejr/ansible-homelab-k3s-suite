apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: {{ openwebrx_app_name }}
  namespace: {{ openwebrx_namespace }}
spec:
  entryPoints:
    - websecure
  routes:
    - match: Host(`{{ openwebrx_hostname }}`)
      kind: Rule
{% if openwebrx_ingress_middlewares | length > 0 %}
      middlewares:
{% for middleware in openwebrx_ingress_middlewares %}
        - name: {{ middleware }}
{% endfor %}
{% endif %}
      services:
        - name: {{ openwebrx_app_name }}
          port: {{ openwebrx_service_port }}
{% if openwebrx_tls_enabled %}
  tls:
    certResolver: {{ openwebrx_tls_cert_resolver }}
{% endif %}