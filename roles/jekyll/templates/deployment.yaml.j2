apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ jekyll_app_name }}
  namespace: {{ jekyll_namespace }}
spec:
  replicas: {{ jekyll_replicas }}
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: {{ jekyll_app_name }}
  template:
    metadata:
      labels:
        app: {{ jekyll_app_name }}
    spec:
      terminationGracePeriodSeconds: 5
      containers:
        - name: jekyll
          image: {{ jekyll_image }}
          imagePullPolicy: IfNotPresent
          securityContext:
            runAsUser: 1000
            runAsGroup: 1000
          env:
            - name: TMPDIR
              value: /tmp/jekyll
            - name: BUNDLE_APP_CONFIG
              value: /usr/local/bundle
            - name: BUNDLE_PATH
              value: /usr/local/bundle
            - name: GEM_HOME
              value: /usr/local/bundle
            - name: GEM_PATH
              value: /usr/local/bundle
          command:
            - sh
            - -c
            - |
              set -e
              cd /srv/jekyll
              exec bundle exec jekyll serve \
                --trace \
                --host 0.0.0.0 \
                --port {{ jekyll_container_port }} \
                --source /srv/jekyll \
                --destination /tmp/jekyll-site \
                --disable-disk-cache \
                --force_polling
          ports:
            - name: http
              containerPort: {{ jekyll_container_port }}
          startupProbe:
            tcpSocket:
              port: http
            failureThreshold: 60
            periodSeconds: 5
          readinessProbe:
            tcpSocket:
              port: http
            initialDelaySeconds: 5
            periodSeconds: 5
            failureThreshold: 6
          livenessProbe:
            tcpSocket:
              port: http
            initialDelaySeconds: 30
            periodSeconds: 10
            failureThreshold: 3
          volumeMounts:
            - name: jekyll-tmp
              mountPath: /tmp/jekyll
            - name: jekyll-site
              mountPath: /tmp/jekyll-site

      volumes:
        - name: jekyll-tmp
          emptyDir: {}
        - name: jekyll-site
          emptyDir: {}