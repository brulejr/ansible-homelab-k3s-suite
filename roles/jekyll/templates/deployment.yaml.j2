apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ jekyll_app_name }}
  namespace: {{ jekyll_namespace }}
spec:
  replicas: {{ jekyll_replicas }}
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: {{ jekyll_app_name }}
  template:
    metadata:
      labels:
        app: {{ jekyll_app_name }}
    spec:
      terminationGracePeriodSeconds: 5

      initContainers:
        - name: git-sync-init
          image: {{ jekyll_git_sync_image }}
          imagePullPolicy: IfNotPresent
          env:
            - name: GITSYNC_REPO
              value: {{ jekyll_git_repo | quote }}
            - name: GITSYNC_REF
              value: {{ jekyll_git_branch | quote }}
            - name: GITSYNC_ROOT
              value: /git
            - name: GITSYNC_LINK
              value: repo
            - name: GITSYNC_ONE_TIME
              value: "true"
            - name: GITSYNC_SSH
              value: "true"
            - name: GITSYNC_SSH_KEY_FILE
              value: /etc/git-secret/ssh
            - name: GITSYNC_SSH_KNOWN_HOSTS
              value: "true"
            - name: GITSYNC_SSH_KNOWN_HOSTS_FILE
              value: /etc/git-secret/known_hosts
            - name: GITSYNC_SUBMODULES
              value: "off"
            - name: GITSYNC_VERBOSE
              value: "5"
          volumeMounts:
            - name: git-root
              mountPath: /git
            - name: git-secret
              mountPath: /etc/git-secret
              readOnly: true

        - name: copy-site
          image: busybox:1.36
          imagePullPolicy: IfNotPresent
          command:
            - sh
            - -c
            - |
              set -e
              test -e /git/repo
              mkdir -p /site
              cp -a /git/repo/. /site/
              mkdir -p /site/.jekyll-cache /site/_site
              chown -R 1000:1000 /site
              chmod -R u+rwX /site
          volumeMounts:
            - name: git-root
              mountPath: /git
              readOnly: true
            - name: site-root
              mountPath: /site

      containers:
        - name: jekyll
          image: {{ jekyll_image }}
          imagePullPolicy: IfNotPresent
          securityContext:
            runAsUser: 1000
            runAsGroup: 1000
          env:
            - name: TMPDIR
              value: /tmp/jekyll
            - name: JEKYLL_NO_BUNDLER_REQUIRE
              value: "true"
          command:
            - sh
            - -c
            - |
              set -e
              cd /site
              exec jekyll serve \
                --host 0.0.0.0 \
                --port {{ jekyll_container_port }} \
                --source /site \
                --destination /site/_site \
                --force_polling
          ports:
            - containerPort: {{ jekyll_container_port }}
          volumeMounts:
            - name: site-root
              mountPath: /site
            - name: jekyll-tmp
              mountPath: /tmp/jekyll

      volumes:
        - name: git-root
          emptyDir: {}
        - name: git-secret
          secret:
            secretName: {{ jekyll_app_name }}-git
            defaultMode: 0440
        - name: site-root
          emptyDir: {}
        - name: jekyll-tmp
          emptyDir: {}