apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ jekyll_app_name }}
  namespace: {{ jekyll_namespace }}
spec:
  replicas: {{ jekyll_replicas }}
  selector:
    matchLabels:
      app: {{ jekyll_app_name }}
  template:
    metadata:
      labels:
        app: {{ jekyll_app_name }}
    spec:
      securityContext:
        fsGroup: 65533

      containers:
        - name: git-sync
          image: {{ jekyll_git_sync_image }}
          imagePullPolicy: IfNotPresent
          env:
            - name: GITSYNC_REPO
              value: {{ jekyll_git_repo | quote }}
            - name: GITSYNC_REF
              value: {{ jekyll_git_branch | quote }}
            - name: GITSYNC_ROOT
              value: {{ jekyll_git_root_mount_path | quote }}
            - name: GITSYNC_LINK
              value: {{ jekyll_git_link_name | quote }}
            - name: GITSYNC_PERIOD
              value: "{{ jekyll_git_sync_wait_seconds }}s"
            - name: GITSYNC_ONE_TIME
              value: "false"
            - name: GITSYNC_SSH
              value: "true"
            - name: GITSYNC_SSH_KEY_FILE
              value: /etc/git-secret/ssh
            - name: GITSYNC_SSH_KNOWN_HOSTS
              value: "true"
            - name: GITSYNC_SSH_KNOWN_HOSTS_FILE
              value: /etc/git-secret/known_hosts
            - name: GITSYNC_SUBMODULES
              value: "off"
            - name: GITSYNC_VERBOSE
              value: "5"
          volumeMounts:
            - name: git-root
              mountPath: {{ jekyll_git_root_mount_path | quote }}
            - name: git-secret
              mountPath: /etc/git-secret
              readOnly: true

        - name: jekyll
          image: {{ jekyll_image }}
          imagePullPolicy: IfNotPresent
          env:
            - name: TMPDIR
              value: /tmp/jekyll
            - name: JEKYLL_NO_BUNDLER_REQUIRE
              value: "true"
          command:
            - sh
            - -c
            - |
              echo "Waiting for git-sync worktree..."
              until [ -e {{ jekyll_git_root_mount_path }}/{{ jekyll_git_link_name }} ]; do
                ls -la {{ jekyll_git_root_mount_path }} || true
                sleep 2
              done

              echo "Waiting for Gemfile..."
              until [ -f {{ jekyll_git_root_mount_path }}/{{ jekyll_git_link_name }}/Gemfile ]; do
                ls -la {{ jekyll_git_root_mount_path }}/{{ jekyll_git_link_name }} || true
                sleep 2
              done

              mkdir -p /tmp/jekyll /srv/jekyll-cache /srv/jekyll-site

              cd {{ jekyll_git_root_mount_path }}/{{ jekyll_git_link_name }}
              exec jekyll serve \
                --host 0.0.0.0 \
                --port {{ jekyll_container_port }} \
                --source . \
                --destination /srv/jekyll-site \
                --disable-disk-cache \
                --force_polling
          ports:
            - containerPort: {{ jekyll_container_port }}
          volumeMounts:
            - name: git-root
              mountPath: {{ jekyll_git_root_mount_path | quote }}
              readOnly: true
            - name: jekyll-tmp
              mountPath: /tmp/jekyll
            - name: jekyll-site
              mountPath: /srv/jekyll-site
            - name: jekyll-cache
              mountPath: /srv/jekyll-cache

      volumes:
        - name: git-root
          emptyDir: {}
        - name: git-secret
          secret:
            secretName: {{ jekyll_app_name }}-git
            defaultMode: 0440
        - name: jekyll-tmp
          emptyDir: {}
        - name: jekyll-site
          emptyDir: {}
        - name: jekyll-cache
          emptyDir: {}