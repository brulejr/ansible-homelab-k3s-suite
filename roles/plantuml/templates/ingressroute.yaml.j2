apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: {{ plantuml_app_name }}
  namespace: {{ plantuml_namespace }}
spec:
  entryPoints:
    - websecure
  routes:
    - match: Host(`{{ plantuml_hostname }}`)
      kind: Rule
{% if plantuml_ingress_middlewares | length > 0 %}
      middlewares:
{% for middleware in plantuml_ingress_middlewares %}
        - name: {{ middleware }}
{% endfor %}
{% endif %}
      services:
        - name: {{ plantuml_app_name }}
          port: {{ plantuml_service_port }}
{% if plantuml_tls_enabled %}
  tls:
    certResolver: {{ plantuml_tls_cert_resolver }}
{% endif %}